APP_ENV=development
DATABASE_URL=sqlite:///./pharmacy.db
DEMO_MODE=true
PRESENTATION_MODE=true
AI_ENABLED=true
# auto uses Groq when GROQ_API_KEY is present, otherwise deterministic mock mode.
AI_MODE=auto
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MIN_INTERVAL_SECONDS=20
MIN_AI_AUTO_ACCEPT_CONFIDENCE=0.95
MIN_AI_REVIEW_CONFIDENCE=0.80
